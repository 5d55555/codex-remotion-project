<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 背景：新宿夜景，代码绘制 -->
    <com.shinjuku.showdown.ShinjukuView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:shadowColor="#CCE0283C"
            android:shadowRadius="28"
            android:text="@string/title"
            android:textColor="@color/text"
            android:textSize="62sp"
            android:textStyle="bold" />

        <View
            android:layout_width="180dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="#668FA7FF" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.45"
            android:text="@string/subtitle"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.9" />

        <TextView
            android:id="@+id/btn_start"
            style="@style/MenuButton"
            android:background="@drawable/btn_primary"
            android:text="@string/start_game"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_vacant_1"
            style="@style/MenuButton"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_secondary"
            android:text="@string/vacant" />

        <TextView
            android:id="@+id/btn_vacant_2"
            style="@style/MenuButton"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_secondary"
            android:text="@string/vacant" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/version"
            android:textColor="#669AA3C7"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
