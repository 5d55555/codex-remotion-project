<?xml version="1.0" encoding="utf-8"?>
<!-- 根用 merge：直接挂到 Activity 自带的内容 FrameLayout 上，少一层 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 背景：新宿夜景，代码绘制 -->
    <com.shinjuku.showdown.ShinjukuView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 正常高度时内容居中铺满；窗口太矮（分屏、超大字体）时可以滚动，不会被裁掉 -->
    <ScrollView
        android:id="@+id/menu_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:shadowColor="#CCE0283C"
            android:shadowRadius="28"
            android:text="@string/title"
            android:textColor="@color/text"
            android:textSize="@dimen/title_size"
            android:textStyle="bold" />

        <View
            android:layout_width="180dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="#668FA7FF" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.45"
            android:text="@string/subtitle"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/subtitle_size" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.9" />

        <Button
            android:id="@+id/btn_start"
            style="@style/MenuButton"
            android:background="@drawable/btn_primary"
            android:text="@string/start_game"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_vacant_1"
            style="@style/MenuButton"
            android:layout_marginTop="@dimen/menu_gap"
            android:background="@drawable/btn_secondary"
            android:contentDescription="@string/vacant_1_desc"
            android:text="@string/vacant" />

        <Button
            android:id="@+id/btn_vacant_2"
            style="@style/MenuButton"
            android:layout_marginTop="@dimen/menu_gap"
            android:background="@drawable/btn_secondary"
            android:contentDescription="@string/vacant_2_desc"
            android:text="@string/vacant" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="6dp"
            android:text="@string/version"
            android:textColor="#669AA3C7"
            android:textSize="11sp" />
    </LinearLayout>
    </ScrollView>

    <!-- 帧率监视：长按版本号打开 -->
    <com.shinjuku.showdown.FrameStatsView
        android:id="@+id/frame_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp" />
</merge>
