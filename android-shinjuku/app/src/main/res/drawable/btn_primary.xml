<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient android:angle="0" android:startColor="#7E0F1E" android:endColor="#A3182C" />
            <stroke android:width="1.5dp" android:color="#FF8A96" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient android:angle="0" android:startColor="@color/red_dark" android:centerColor="@color/red" android:endColor="@color/red_dark" />
            <stroke android:width="1.5dp" android:color="#FFB3BB" />
        </shape>
    </item>
</selector>
